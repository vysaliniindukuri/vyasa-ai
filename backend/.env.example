# Default LLM provider: groq | openai | gemini | claude
DEFAULT_PROVIDER=groq
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (else provider default is used)
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
CLAUDE_MODEL=claude-sonnet-4-6
# Comma-separated CORS origins ("*" for any during local dev)
FRONTEND_ORIGINS=*
REQUEST_TIMEOUT=60
